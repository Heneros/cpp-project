{
    "configurations": [
        {
            "name": "MSYS POSIX",
            "includePath": [
                "${workspaceFolder}/**",
                "C:/msys64/usr/include/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "_POSIX_C_SOURCE=200809L",
                "__STDC_FORMAT_MACROS",
                "_GNU_SOURCE"
            ],
            "compilerPath": "C:/msys64/usr/bin/g++.exe",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}